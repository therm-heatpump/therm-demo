{
  "id": "rooms_and_zones",
  "name": "Room temperatures and heating zones (name patterns)",
  "priority": 40,
  "roles": {
    "Room_n": {
      "device_class": "temperature",
      "units": [
        "°C",
        "°F",
        "C",
        "F"
      ],
      "patterns": [
        "room|bedroom|living|kitchen|playroom|office|lounge|hall|landing|bathroom|study|dining|nursery|attic|indoor"
      ],
      "excludes": [
        "heat_pump",
        "outdoor",
        "water",
        "tank",
        "cpu",
        "battery",
        "dew",
        "feels",
        "target",
        "setpoint",
        "set_temp",
        "_min",
        "_max",
        "average",
        "mean"
      ],
      "domain": "sensor"
    },
    "Zone_1": {
      "domain": "binary_sensor",
      "patterns": [
        "zone",
        "underfloor|ufh",
        "radiator.*(pump|valve|demand|call)",
